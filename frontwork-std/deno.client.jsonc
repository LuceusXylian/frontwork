{
    "compilerOptions": {
      "lib": ["ES2015", "dom"],
      "strict": true
    },
    "lint": {
      "rules": {
        "tags": ["recommended"],
        "include": [],
        "exclude": ["no-unused-vars", "require-await"]
      }
    },
    "fmt": {
      "useTabs": true,
      "lineWidth": 80,
      "indentWidth": 4,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
}
